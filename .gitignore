__pycache__/
*.pyc
.pytest_cache/
.venv/
dist/
*.egg-info/
.DS_Store
# local scratch runs; reference/community runs are committed deliberately
runs/local/

# continuous stack-watch: keep state/history in git so hourly Actions
# can resume adaptive backoff. Ignore only local temp files.
runs/watch/*.tmp
runs/watch/last-tick.json

# internal dry-run fixtures (public template is configs/example.json + cases/default/)
configs/dryrun-*.json
cases/dryrun-*/

# benchmark scratch
.benchmarks/
